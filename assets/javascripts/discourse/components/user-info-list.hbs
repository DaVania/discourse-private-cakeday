<ul class="user-info-list">
  {{#each @this.users as |user|}}
    <li class="user-info-item">
      <UserInfo @user={{user}}>
        <div>{{cakeday-date this.user.cakedate isBirthday=@this.isBirthday}}</div>
      </UserInfo>
    </li>
  {{else}}
    <div class="user-info-empty-message"><h4>{{this.yield}}</h4></div>
  {{/each}}
</ul>
